# Firebase (passo 8). Sem estas variáveis o jogo funciona e guarda o progresso só no navegador.
# Copie para .env.local e preencha com os valores do console do Firebase
# (Configurações do projeto > Seus apps > app da Web). A chave de API é pública por design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
